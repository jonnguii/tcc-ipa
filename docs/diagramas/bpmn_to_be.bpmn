<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_IPA_TO_BE"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="bpmn-js (https://demo.bpmn.io)"
                  exporterVersion="17.0.0">
  <bpmn:process id="Process_IPA_TO_BE" name="Arquitetura TO-BE: Automação Inteligente de Processos (IPA)" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Documento Recebido (TXT/PDF/PNG)">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_IA" name="1. Extração IA (Gemini Flash + Cache MD5)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_Regras" name="2. Normalização e Validação Fiscal (CPF/CNPJ)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:businessRuleTask id="Task_Fuzzy" name="3. Casamento Fuzzy de Catálogo (RapidFuzz)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_Roteamento" name="Qual a rota da triagem?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto</bpmn:outgoing>
      <bpmn:outgoing>Flow_Revisao</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejeicao</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_RPA" name="4. Executar RPA no ERP (Playwright)">
      <bpmn:incoming>Flow_Auto</bpmn:incoming>
      <bpmn:incoming>Flow_Humano_Aprovado</bpmn:incoming>
      <bpmn:outgoing>Flow_Sucesso</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Sucesso" name="Pedido Cadastrado com Sucesso no ERP">
      <bpmn:incoming>Flow_Sucesso</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_RevisaoHumana" name="5. Revisão Humana (Split View e Cronômetro)">
      <bpmn:incoming>Flow_Revisao</bpmn:incoming>
      <bpmn:outgoing>Flow_Decisao_Humana</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Humano" name="Operador aprovou?">
      <bpmn:incoming>Flow_Decisao_Humana</bpmn:incoming>
      <bpmn:outgoing>Flow_Humano_Aprovado</bpmn:outgoing>
      <bpmn:outgoing>Flow_Humano_Rejeitado</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Rejeitado" name="Pedido Rejeitado e Gravado em Auditoria">
      <bpmn:incoming>Flow_Rejeicao</bpmn:incoming>
      <bpmn:incoming>Flow_Humano_Rejeitado</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_IA" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_IA" targetRef="Task_Regras" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Regras" targetRef="Task_Fuzzy" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Fuzzy" targetRef="Gateway_Roteamento" />

    <bpmn:sequenceFlow id="Flow_Auto" name="AUTOMÁTICO (Score &gt;= 85%)" sourceRef="Gateway_Roteamento" targetRef="Task_RPA" />
    <bpmn:sequenceFlow id="Flow_Revisao" name="REVISÃO (Ambíguo / Pendência)" sourceRef="Gateway_Roteamento" targetRef="Task_RevisaoHumana" />
    <bpmn:sequenceFlow id="Flow_Rejeicao" name="REJEIÇÃO (Fraude / Erro Crítico)" sourceRef="Gateway_Roteamento" targetRef="EndEvent_Rejeitado" />

    <bpmn:sequenceFlow id="Flow_Sucesso" sourceRef="Task_RPA" targetRef="EndEvent_Sucesso" />
    <bpmn:sequenceFlow id="Flow_Decisao_Humana" sourceRef="Task_RevisaoHumana" targetRef="Gateway_Humano" />
    <bpmn:sequenceFlow id="Flow_Humano_Aprovado" name="Corrigido / Aprovado" sourceRef="Gateway_Humano" targetRef="Task_RPA" />
    <bpmn:sequenceFlow id="Flow_Humano_Rejeitado" name="Rejeitado" sourceRef="Gateway_Humano" targetRef="EndEvent_Rejeitado" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_IPA_TO_BE">
      <!-- Start Event -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="135" y="285" width="86" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task IA -->
      <bpmndi:BPMNShape id="Task_IA_di" bpmnElement="Task_IA">
        <dc:Bounds x="250" y="220" width="130" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task Regras -->
      <bpmndi:BPMNShape id="Task_Regras_di" bpmnElement="Task_Regras">
        <dc:Bounds x="430" y="220" width="140" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task Fuzzy -->
      <bpmndi:BPMNShape id="Task_Fuzzy_di" bpmnElement="Task_Fuzzy">
        <dc:Bounds x="620" y="220" width="140" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Roteamento -->
      <bpmndi:BPMNShape id="Gateway_Roteamento_di" bpmnElement="Gateway_Roteamento" isMarkerVisible="true">
        <dc:Bounds x="815" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="806" y="292" width="69" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task RPA -->
      <bpmndi:BPMNShape id="Task_RPA_di" bpmnElement="Task_RPA">
        <dc:Bounds x="970" y="100" width="140" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Sucesso -->
      <bpmndi:BPMNShape id="EndEvent_Sucesso_di" bpmnElement="EndEvent_Sucesso">
        <dc:Bounds x="1192" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1169" y="165" width="82" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task Revisão Humana -->
      <bpmndi:BPMNShape id="Task_RevisaoHumana_di" bpmnElement="Task_RevisaoHumana">
        <dc:Bounds x="970" y="220" width="140" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Humano -->
      <bpmndi:BPMNShape id="Gateway_Humano_di" bpmnElement="Gateway_Humano" isMarkerVisible="true">
        <dc:Bounds x="1185" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1185" y="292" width="51" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- End Rejeitado -->
      <bpmndi:BPMNShape id="EndEvent_Rejeitado_di" bpmnElement="EndEvent_Rejeitado">
        <dc:Bounds x="1192" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1169" y="425" width="82" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges / Conexões -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="196" y="260" />
        <di:waypoint x="250" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="380" y="260" />
        <di:waypoint x="430" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="570" y="260" />
        <di:waypoint x="620" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="760" y="260" />
        <di:waypoint x="815" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Auto_di" bpmnElement="Flow_Auto">
        <di:waypoint x="840" y="235" />
        <di:waypoint x="840" y="140" />
        <di:waypoint x="970" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="850" y="150" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Revisao_di" bpmnElement="Flow_Revisao">
        <di:waypoint x="865" y="260" />
        <di:waypoint x="970" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="876" y="226" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Rejeicao_di" bpmnElement="Flow_Rejeicao">
        <di:waypoint x="840" y="285" />
        <di:waypoint x="840" y="400" />
        <di:waypoint x="1192" y="400" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="850" y="366" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Sucesso_di" bpmnElement="Flow_Sucesso">
        <di:waypoint x="1110" y="140" />
        <di:waypoint x="1192" y="140" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Decisao_Humana_di" bpmnElement="Flow_Decisao_Humana">
        <di:waypoint x="1110" y="260" />
        <di:waypoint x="1185" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Humano_Aprovado_di" bpmnElement="Flow_Humano_Aprovado">
        <di:waypoint x="1210" y="235" />
        <di:waypoint x="1210" y="80" />
        <di:waypoint x="1040" y="80" />
        <di:waypoint x="1040" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1145" y="60" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Humano_Rejeitado_di" bpmnElement="Flow_Humano_Rejeitado">
        <di:waypoint x="1210" y="285" />
        <di:waypoint x="1210" y="382" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1216" y="325" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
